{
  "title": "Kvant — Services",
  "uid": "kvant-services",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "tags": ["kvant", "services"],
  "graphTooltip": 1,
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "label": "Service",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_requests_total, job)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".+",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Services Up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(up{job=~\"auth_service|user_service|product_service|cart_service|order_service|payment_service|chat_service\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "textMode": "value_and_name",
        "graphMode": "none",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "green", "value": 7 }
            ]
          },
          "mappings": [],
          "unit": "short",
          "color": { "mode": "thresholds" },
          "displayName": "Services Up"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total RPS",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=~\"auth_service|user_service|product_service|cart_service|order_service|payment_service|chat_service\"}[2m]))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "textMode": "value_and_name",
        "graphMode": "area",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "#5794F2" },
          "displayName": "RPS"
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error Rate (5xx)",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\",job=~\"auth_service|user_service|product_service|cart_service|order_service|payment_service|chat_service\"}[5m])) / sum(rate(http_requests_total{job=~\"auth_service|user_service|product_service|cart_service|order_service|payment_service|chat_service\"}[5m]))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "textMode": "value_and_name",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "color": { "mode": "thresholds" },
          "displayName": "5xx Rate"
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "P95 Latency",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=~\"auth_service|user_service|product_service|cart_service|order_service|payment_service|chat_service\"}[5m])))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "textMode": "value_and_name",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 1.0 }
            ]
          },
          "color": { "mode": "thresholds" },
          "displayName": "P95 Latency"
        }
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Success Rate",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"2..\",job=~\"auth_service|user_service|product_service|cart_service|order_service|payment_service|chat_service\"}[5m])) / sum(rate(http_requests_total{job=~\"auth_service|user_service|product_service|cart_service|order_service|payment_service|chat_service\"}[5m]))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "textMode": "value_and_name",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.95 },
              { "color": "green", "value": 0.99 }
            ]
          },
          "color": { "mode": "thresholds" },
          "displayName": "Success Rate"
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Requests (1h)",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(http_requests_total{job=~\"auth_service|user_service|product_service|cart_service|order_service|payment_service|chat_service\"}[1h]))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "#B877D9" },
          "displayName": "Requests"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Traffic",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Requests per second — by service",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(http_requests_total{job=\"auth_service\"}[2m]))", "legendFormat": "auth", "refId": "A" },
        { "expr": "sum(rate(http_requests_total{job=\"user_service\"}[2m]))", "legendFormat": "user", "refId": "B" },
        { "expr": "sum(rate(http_requests_total{job=\"product_service\"}[2m]))", "legendFormat": "product", "refId": "C" },
        { "expr": "sum(rate(http_requests_total{job=\"cart_service\"}[2m]))", "legendFormat": "cart", "refId": "D" },
        { "expr": "sum(rate(http_requests_total{job=\"order_service\"}[2m]))", "legendFormat": "order", "refId": "E" },
        { "expr": "sum(rate(http_requests_total{job=\"payment_service\"}[2m]))", "legendFormat": "payment", "refId": "F" },
        { "expr": "sum(rate(http_requests_total{job=\"chat_service\"}[2m]))", "legendFormat": "chat", "refId": "G" }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "scheme",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "auth" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#5794F2" } }] },
          { "matcher": { "id": "byName", "options": "user" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } }] },
          { "matcher": { "id": "byName", "options": "product" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FADE2A" } }] },
          { "matcher": { "id": "byName", "options": "cart" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF9830" } }] },
          { "matcher": { "id": "byName", "options": "order" },   "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#B877D9" } }] },
          { "matcher": { "id": "byName", "options": "payment" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#F2495C" } }] },
          { "matcher": { "id": "byName", "options": "chat" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4FC4CF" } }] }
        ]
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Errors",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "5xx Error rate — by service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(http_requests_total{job=\"auth_service\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"auth_service\"}[5m]))", "legendFormat": "auth", "refId": "A" },
        { "expr": "sum(rate(http_requests_total{job=\"user_service\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"user_service\"}[5m]))", "legendFormat": "user", "refId": "B" },
        { "expr": "sum(rate(http_requests_total{job=\"product_service\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"product_service\"}[5m]))", "legendFormat": "product", "refId": "C" },
        { "expr": "sum(rate(http_requests_total{job=\"cart_service\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"cart_service\"}[5m]))", "legendFormat": "cart", "refId": "D" },
        { "expr": "sum(rate(http_requests_total{job=\"order_service\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"order_service\"}[5m]))", "legendFormat": "order", "refId": "E" },
        { "expr": "sum(rate(http_requests_total{job=\"payment_service\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"payment_service\"}[5m]))", "legendFormat": "payment", "refId": "F" },
        { "expr": "sum(rate(http_requests_total{job=\"chat_service\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"chat_service\"}[5m]))", "legendFormat": "chat", "refId": "G" }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "auth" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#5794F2" } }] },
          { "matcher": { "id": "byName", "options": "user" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } }] },
          { "matcher": { "id": "byName", "options": "product" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FADE2A" } }] },
          { "matcher": { "id": "byName", "options": "cart" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF9830" } }] },
          { "matcher": { "id": "byName", "options": "order" },   "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#B877D9" } }] },
          { "matcher": { "id": "byName", "options": "payment" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#F2495C" } }] },
          { "matcher": { "id": "byName", "options": "chat" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4FC4CF" } }] }
        ]
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "4xx Client errors — by service",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(http_requests_total{job=\"auth_service\",status=~\"4..\"}[5m]))", "legendFormat": "auth", "refId": "A" },
        { "expr": "sum(rate(http_requests_total{job=\"user_service\",status=~\"4..\"}[5m]))", "legendFormat": "user", "refId": "B" },
        { "expr": "sum(rate(http_requests_total{job=\"product_service\",status=~\"4..\"}[5m]))", "legendFormat": "product", "refId": "C" },
        { "expr": "sum(rate(http_requests_total{job=\"cart_service\",status=~\"4..\"}[5m]))", "legendFormat": "cart", "refId": "D" },
        { "expr": "sum(rate(http_requests_total{job=\"order_service\",status=~\"4..\"}[5m]))", "legendFormat": "order", "refId": "E" },
        { "expr": "sum(rate(http_requests_total{job=\"payment_service\",status=~\"4..\"}[5m]))", "legendFormat": "payment", "refId": "F" },
        { "expr": "sum(rate(http_requests_total{job=\"chat_service\",status=~\"4..\"}[5m]))", "legendFormat": "chat", "refId": "G" }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "auth" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#5794F2" } }] },
          { "matcher": { "id": "byName", "options": "user" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } }] },
          { "matcher": { "id": "byName", "options": "product" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FADE2A" } }] },
          { "matcher": { "id": "byName", "options": "cart" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF9830" } }] },
          { "matcher": { "id": "byName", "options": "order" },   "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#B877D9" } }] },
          { "matcher": { "id": "byName", "options": "payment" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#F2495C" } }] },
          { "matcher": { "id": "byName", "options": "chat" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4FC4CF" } }] }
        ]
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false
    },
