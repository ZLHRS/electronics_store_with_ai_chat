    {
      "id": 32,
      "type": "timeseries",
      "title": "P95 Latency — by service",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"auth_service\"}[5m])))", "legendFormat": "auth", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"user_service\"}[5m])))", "legendFormat": "user", "refId": "B" },
