# ── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=paymentdb
DB_ECHO=false

# Connection pool
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_ECHO_POOL=false

# ── Auth (shared secret with auth_service) ───────────────────────────────────
AUTH_SECRET_KEY=
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_NAME=access_token

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Order Service ─────────────────────────────────────────────────────────────
ORDER_SERVICE_URL=http://localhost:8004

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=WARNING

# ── Tests ─────────────────────────────────────────────────────────────────────
# TEST_DB_NAME=paymentdb_test
